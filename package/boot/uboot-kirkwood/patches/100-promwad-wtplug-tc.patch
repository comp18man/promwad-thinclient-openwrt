diff --git a/drivers/video/xgi.c b/drivers/video/xgi.c
new file mode 100644
index 00000000000..fac1b2a2b13
--- /dev/null
+++ b/drivers/video/xgi.c
@@ -0,0 +1,1375 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * XGI Volari Z11 (XG27) video driver
+ *
+ * The chip is brought up without a video BIOS. Register programming follows
+ * the Linux xgifb staging driver by XGITECH and others, which in turn is
+ * based on the SiS frame buffer driver.
+ */
+
+#define LOG_CATEGORY	UCLASS_VIDEO
+
+#include <dm.h>
+#include <log.h>
+#include <pci.h>
+#include <video.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include "videomodes.h"
+#include "xgi_tables.h"
+
+/* the relocated I/O BAR holds VGA ports 0x380-0x3ff */
+#define XGI_IO_BASE		0x380
+
+#define VGA_ATT_W		0x3c0
+#define VGA_MIS_W		0x3c2
+#define VGA_IS0_R		0x3c2
+#define VGA_SEQ_I		0x3c4
+#define VGA_PEL_MSK		0x3c6
+#define VGA_PEL_IW		0x3c8
+#define VGA_PEL_D		0x3c9
+#define VGA_GFX_I		0x3ce
+#define VGA_CRT_IC		0x3d4
+#define VGA_IS1_RC		0x3da
+
+#define XGI_PASSWORD		0x86
+#define XGI_PASSWORD_OK		0xa1
+
+#define XGI_MODE_INFO_MAGIC	0x42464758	/* "XGFB" */
+#define XGI_MODE_INFO_SIZE	SZ_4K
+
+/* xgi_ext_mode.mode_flag and xgi_ref_rate.info_flag */
+#define MODE_TYPE_MASK		0x0007
+#define MODE_EGA		0x02
+#define MODE_VGA		0x03
+#define INTERLACE_MODE		0x0080
+#define LINE_COMPARE_OFF	0x0400
+#define HALF_DCLK		0x1000
+#define DOUBLE_SCAN_MODE	0x8000
+#define HSYNC_NEGATIVE		0x4000
+#define VSYNC_NEGATIVE		0x8000
+
+/* CR32 */
+#define AVIDEO_SENSE		0x01
+#define SVIDEO_SENSE		0x02
+#define SCART_SENSE		0x04
+#define LCD_SENSE		0x08
+#define MONITOR2_SENSE		0x10
+#define MONITOR1_SENSE		0x20
+#define HITV_SENSE		0x40
+#define YPBPR_SENSE		0x80
+#define TV_SENSE		0xc7
+
+/* CR3D, CR3E */
+#define ACTIVE_CRT1		0x0010
+#define ACTIVE_LCD		0x0020
+#define ACTIVE_TV		0x0040
+#define ACTIVE_CRT2		0x0080
+#define ACTIVE_AVIDEO		0x0100
+#define ACTIVE_SVIDEO		0x0200
+#define ACTIVE_SCART		0x0400
+#define ACTIVE_HITV		0x0800
+#define ACTIVE_YPBPR		0x1000
+#define DISPLAY_FROM_CMOS	0x10
+
+/* CR30, CR31 */
+#define SET_SIMU_SCAN_MODE	0x0001
+#define SWITCH_CRT2		0x0002
+#define SET_CRT2_TO_AVIDEO	0x0004
+#define SET_CRT2_TO_SVIDEO	0x0008
+#define SET_CRT2_TO_SCART	0x0010
+#define SET_CRT2_TO_LCD		0x0020
+#define SET_NOT_SIMU_MODE	0x0400
+#define DISABLE_CRT2_DISPLAY	0x2000
+#define DRIVER_MODE		0x4000
+
+/* CR38 */
+#define SET_TO_LCDA		0x02
+#define ENABLE_DUAL_EDGE	0x01
+#define SET_YPBPR		0x04
+
+#define MODE_16BPP		0x05
+#define MODE_32BPP		0x07
+
+struct xgi_mode {
+	uint xres;
+	uint yres;
+	uint bpp;
+	uint refresh;
+	u8 mode_no;
+	u8 rate;
+};
+
+struct xgi_priv {
+	void __iomem *io;
+	void __iomem *fb;
+	ulong fb_size;
+	u8 cr97;
+	int ram_type;
+	bool lvds;
+	u8 mode_no;
+	u16 mode_type;
+	const struct xgi_ext_mode *ext;
+};
+
+static u8 xgi_in(struct xgi_priv *priv, uint port)
+{
+	return readb(priv->io + port - XGI_IO_BASE);
+}
+
+static void xgi_out(struct xgi_priv *priv, uint port, u8 val)
+{
+	writeb(val, priv->io + port - XGI_IO_BASE);
+}
+
+static u8 xgi_get(struct xgi_priv *priv, uint port, u8 index)
+{
+	xgi_out(priv, port, index);
+	return xgi_in(priv, port + 1);
+}
+
+static void xgi_set(struct xgi_priv *priv, uint port, u8 index, u8 val)
+{
+	xgi_out(priv, port, index);
+	xgi_out(priv, port + 1, val);
+}
+
+static void xgi_and_or(struct xgi_priv *priv, uint port, u8 index, uint and,
+		       uint or)
+{
+	xgi_set(priv, port, index, (xgi_get(priv, port, index) & and) | or);
+}
+
+static void xgi_and(struct xgi_priv *priv, uint port, u8 index, uint and)
+{
+	xgi_set(priv, port, index, xgi_get(priv, port, index) & and);
+}
+
+static void xgi_or(struct xgi_priv *priv, uint port, u8 index, uint or)
+{
+	xgi_set(priv, port, index, xgi_get(priv, port, index) | or);
+}
+
+/* SR3B[7] and SR3B[3] are the MAA15 and MAA11 power-on straps */
+static bool xgi_strapped_ddr(struct xgi_priv *priv)
+{
+	u8 sr3b = xgi_get(priv, VGA_SEQ_I, 0x3b) & 0x88;
+
+	return sr3b == 0x80 || sr3b == 0x08;
+}
+
+static u8 xgi_psc_value(struct xgi_priv *priv)
+{
+	u8 cr4a = xgi_get(priv, VGA_CRT_IC, 0x4a);
+	u8 val;
+
+	xgi_and(priv, VGA_CRT_IC, 0x4a, ~0x0c);
+	val = (xgi_get(priv, VGA_CRT_IC, 0x48) & 0x0c) >> 2;
+	xgi_set(priv, VGA_CRT_IC, 0x4a, cr4a);
+
+	return val | (xgi_get(priv, VGA_CRT_IC, 0xb4) & 0x04) << 3;
+}
+
+/* bit 5: panel signal, bit 1: backlight, bit 0: panel power */
+static void xgi_bl_signal_vdd(struct xgi_priv *priv, uint mask, uint val)
+{
+	if (mask & 0x20)
+		xgi_and_or(priv, VGA_CRT_IC, 0xb4, ~0x02, (val >> 4) & 0x02);
+	xgi_and_or(priv, VGA_CRT_IC, 0xb4, ~((mask & 0x20) >> 3),
+		   (val & 0x20) >> 3);
+
+	mask = (mask & 0x03) << 2;
+	val = (val & 0x03) << 2;
+	xgi_and(priv, VGA_CRT_IC, 0x4a, ~mask);
+	xgi_and_or(priv, VGA_CRT_IC, 0x48, ~mask, val);
+}
+
+static void xgi_display_off(struct xgi_priv *priv)
+{
+	if (xgi_psc_value(priv) & 0x02)
+		xgi_bl_signal_vdd(priv, 0x02, 0x00);
+	if (!priv->lvds)
+		xgi_bl_signal_vdd(priv, 0x20, 0x00);
+
+	xgi_and_or(priv, VGA_SEQ_I, 0x01, 0xdf, 0x20);
+}
+
+static void xgi_display_on(struct xgi_priv *priv)
+{
+	xgi_and(priv, VGA_SEQ_I, 0x01, 0xdf);
+	if (!priv->lvds)
+		xgi_bl_signal_vdd(priv, 0x20, 0x20);
+}
+
+static void xgi_set_std_regs(struct xgi_priv *priv)
+{
+	int i;
+
+	xgi_set(priv, VGA_SEQ_I, 0x00, 0x03);
+	for (i = 0; i < 4; i++)
+		xgi_set(priv, VGA_SEQ_I, i + 1, xgi_std_regs.sr[i]);
+
+	xgi_out(priv, VGA_MIS_W, xgi_std_regs.misc);
+
+	xgi_and(priv, VGA_CRT_IC, 0x11, 0x7f);
+	for (i = 0; i <= 0x18; i++)
+		xgi_set(priv, VGA_CRT_IC, i, xgi_std_regs.crtc[i]);
+
+	for (i = 0; i <= 0x13; i++) {
+		xgi_in(priv, VGA_IS1_RC);
+		xgi_out(priv, VGA_ATT_W, i);
+		xgi_out(priv, VGA_ATT_W, xgi_std_regs.attr[i]);
+	}
+	xgi_in(priv, VGA_IS1_RC);
+	xgi_out(priv, VGA_ATT_W, 0x14);
+	xgi_out(priv, VGA_ATT_W, 0x00);
+	xgi_in(priv, VGA_IS1_RC);
+	xgi_out(priv, VGA_ATT_W, 0x20);
+
+	for (i = 0; i <= 0x08; i++)
+		xgi_set(priv, VGA_GFX_I, i, xgi_std_regs.grc[i]);
+	if (priv->mode_type > MODE_VGA)
+		xgi_and(priv, VGA_GFX_I, 0x05, 0xbf);
+
+	for (i = 0x0a; i <= 0x0e; i++)
+		xgi_set(priv, VGA_SEQ_I, i, 0x00);
+}
+
+static void xgi_set_default_vclk(struct xgi_priv *priv)
+{
+	xgi_and_or(priv, VGA_SEQ_I, 0x31, ~0x30, 0x20);
+	xgi_set(priv, VGA_SEQ_I, 0x2b, xgi_vclks[0].sr2b);
+	xgi_set(priv, VGA_SEQ_I, 0x2c, xgi_vclks[0].sr2c);
+
+	xgi_and_or(priv, VGA_SEQ_I, 0x31, ~0x30, 0x10);
+	xgi_set(priv, VGA_SEQ_I, 0x2b, xgi_vclks[1].sr2b);
+	xgi_set(priv, VGA_SEQ_I, 0x2c, xgi_vclks[1].sr2c);
+
+	xgi_and(priv, VGA_SEQ_I, 0x31, ~0x30);
+}
+
+static const struct xgi_ref_rate *xgi_find_rate(struct xgi_priv *priv)
+{
+	const struct xgi_ref_rate *rate = &xgi_ref_rates[priv->ext->ref_index];
+	u16 index = xgi_get(priv, VGA_CRT_IC, 0x33) & 0x0f;
+	int i;
+
+	if (index > 0)
+		index--;
+
+	if ((rate->xres == 800 && rate->yres == 600) ||
+	    (rate->xres == 1024 && rate->yres == 768) ||
+	    (rate->xres == 1280 && rate->yres == 1024))
+		index++;
+
+	i = 0;
+	do {
+		if (rate[i].mode_id != rate->mode_id)
+			break;
+		if ((rate[i].info_flag & MODE_TYPE_MASK) < priv->mode_type)
+			break;
+		i++;
+		index--;
+	} while (index != 0xffff);
+
+	return &rate[i - 1];
+}
+
+static void xgi_set_crt1_crtc(struct xgi_priv *priv,
+			      const struct xgi_ref_rate *rate)
+{
+	const u8 *t = xgi_crt1_timings[rate->crt1_crtc].cr;
+	u8 data, data1;
+	int i;
+
+	xgi_and(priv, VGA_CRT_IC, 0x11, 0x7f);
+
+	xgi_set(priv, VGA_CRT_IC, 0x00, t[0]);
+	for (i = 1; i <= 4; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 1, t[i]);
+	for (i = 5; i <= 6; i++)
+		xgi_set(priv, VGA_SEQ_I, i + 6, t[i]);
+	xgi_and_or(priv, VGA_SEQ_I, 0x0e, 0x1f, t[7] & 0xe0);
+
+	data = xgi_get(priv, VGA_CRT_IC, 0x04);
+	xgi_set(priv, VGA_CRT_IC, 0x04, data - 1);
+	data = xgi_get(priv, VGA_CRT_IC, 0x05);
+	data1 = data & 0xe0;
+	data &= 0x1f;
+	if (!data)
+		xgi_and(priv, VGA_SEQ_I, 0x0c, 0xfb);
+	data--;
+	xgi_set(priv, VGA_CRT_IC, 0x05, data | data1);
+	data = (xgi_get(priv, VGA_SEQ_I, 0x0e) >> 5) + 3;
+	if (data > 7)
+		data -= 7;
+	xgi_and_or(priv, VGA_SEQ_I, 0x0e, ~0xe0, data << 5);
+
+	for (i = 0; i <= 1; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 6, t[8 + i]);
+	for (i = 2; i <= 3; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 0x0e, t[8 + i]);
+	for (i = 4; i <= 5; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 0x11, t[8 + i]);
+	xgi_and_or(priv, VGA_SEQ_I, 0x0a, 0xc0, t[14] & 0x3f);
+
+	data = (t[14] & 0x80) >> 2;
+	if (priv->ext->mode_flag & DOUBLE_SCAN_MODE)
+		data |= 0x80;
+	xgi_and_or(priv, VGA_CRT_IC, 0x09, 0x5f, data);
+
+	if (priv->mode_type > 0x03)
+		xgi_set(priv, VGA_CRT_IC, 0x14, 0x4f);
+}
+
+static void xgi_set_crt1_de(struct xgi_priv *priv,
+			    const struct xgi_ref_rate *rate)
+{
+	const struct xgi_mode_res *res = &xgi_mode_res[priv->ext->res_info];
+	u16 htotal = res->htotal;
+	u16 vtotal = res->vtotal;
+	u8 cr11;
+
+	if (priv->ext->mode_flag & HALF_DCLK)
+		htotal &= ~1;
+	if (rate->info_flag & INTERLACE_MODE)
+		vtotal >>= 1;
+	if (priv->ext->mode_flag & DOUBLE_SCAN_MODE)
+		vtotal <<= 1;
+	htotal = htotal / 8 - 1;
+	vtotal -= 1;
+
+	cr11 = xgi_get(priv, VGA_CRT_IC, 0x11);
+	xgi_set(priv, VGA_CRT_IC, 0x11, cr11 & 0x7f);
+	xgi_set(priv, VGA_CRT_IC, 0x01, htotal & 0xff);
+	xgi_and_or(priv, VGA_CRT_IC, 0x0b, ~0x0c, (htotal & 0xff00) >> 10);
+	xgi_set(priv, VGA_CRT_IC, 0x12, vtotal & 0xff);
+	vtotal >>= 8;
+	xgi_and_or(priv, VGA_CRT_IC, 0x07, ~0x42,
+		   (vtotal & 0x01 ? 0x02 : 0) | (vtotal & 0x02 ? 0x40 : 0));
+	xgi_and_or(priv, VGA_CRT_IC, 0x0a, ~0x02, vtotal & 0x04 ? 0x02 : 0);
+	xgi_set(priv, VGA_CRT_IC, 0x11, cr11);
+}
+
+static void xgi_set_crt1_offset(struct xgi_priv *priv,
+				const struct xgi_ref_rate *rate)
+{
+	u16 offset, scale, unit;
+	u8 high;
+
+	offset = xgi_screen_offset[priv->ext->mode_info >> 8];
+	if (rate->info_flag & INTERLACE_MODE)
+		offset <<= 1;
+
+	scale = priv->mode_type - MODE_EGA;
+	switch (scale) {
+	case 0:
+		scale = 1;
+		break;
+	case 1:
+		scale = 2;
+		break;
+	case 2:
+	case 3:
+		scale = 4;
+		break;
+	case 4:
+		scale = 6;
+		break;
+	case 5:
+		scale = 8;
+		break;
+	}
+
+	if (priv->mode_no >= 0x26 && priv->mode_no <= 0x28)
+		offset = offset * scale + scale / 2;
+	else
+		offset *= scale;
+
+	xgi_and_or(priv, VGA_SEQ_I, 0x0e, 0xf0, (offset >> 8) & 0x0f);
+	xgi_set(priv, VGA_CRT_IC, 0x13, offset & 0xff);
+
+	unit = offset;
+	if (rate->info_flag & INTERLACE_MODE)
+		unit >>= 1;
+	unit <<= 5;
+	high = (unit >> 8) + ((unit & 0xff) ? 2 : 1);
+	if (priv->mode_no == 0x4a || priv->mode_no == 0x49)
+		high--;
+	xgi_set(priv, VGA_SEQ_I, 0x10, high);
+}
+
+static void xgi_set_crt1_vclk(struct xgi_priv *priv,
+			      const struct xgi_ref_rate *rate)
+{
+	const struct xgi_vclk *vclk = &xgi_vclks[rate->crt_vclk];
+	u8 data;
+
+	xgi_and(priv, VGA_SEQ_I, 0x31, 0xcf);
+	xgi_set(priv, VGA_SEQ_I, 0x2b, vclk->sr2b);
+	xgi_set(priv, VGA_SEQ_I, 0x2c, vclk->sr2c);
+	xgi_set(priv, VGA_SEQ_I, 0x2d, 0x01);
+
+	if (priv->ext->mode_flag & HALF_DCLK) {
+		xgi_set(priv, VGA_SEQ_I, 0x2b, xgi_get(priv, VGA_SEQ_I, 0x2b));
+		data = xgi_get(priv, VGA_SEQ_I, 0x2c);
+		data = (data & 0xe0) | (((data & 0x1f) << 1) + 1);
+		xgi_set(priv, VGA_SEQ_I, 0x2c, data);
+	}
+}
+
+/* sync and display timings of the XG27 digital output */
+static void xgi_set_xg27_crtc(struct xgi_priv *priv,
+			      const struct xgi_ref_rate *rate)
+{
+	const u8 *t = xgi_crt1_timings[rate->crt1_crtc].cr;
+	u16 hrs, hre, vrs, vre;
+
+	hrs = t[3] | (t[5] & 0xc0) << 2;
+	hre = (t[4] & 0x1f) | (t[6] & 0x04) << 3;
+	xgi_set(priv, VGA_SEQ_I, 0x2e, t[3]);
+	hrs = (hrs & 0x3c0) | hre;
+	if (hre <= (t[3] & 0x3f))
+		hrs += 0x40;
+	xgi_set(priv, VGA_SEQ_I, 0x2f, (t[5] & 0xc0) >> 6 | ((hrs << 2) & 0xff));
+	xgi_and(priv, VGA_SEQ_I, 0x30, 0xe3);
+
+	xgi_set(priv, VGA_SEQ_I, 0x34, t[10]);
+	xgi_and_or(priv, VGA_SEQ_I, 0x35, ~0x01, (t[9] & 0x04) >> 2);
+	vrs = t[10] | (t[9] & 0x04) << 6 | (t[9] & 0x80) << 2 |
+	      (t[14] & 0x08) << 7;
+	vre = (t[11] & 0x0f) | (t[14] & 0x20) >> 1;
+	vre |= vrs & 0x7e0;
+	if (vre <= vrs)
+		vre |= 0x20;
+	xgi_and_or(priv, VGA_SEQ_I, 0x3f, ~0xfc, (vre << 2) & 0xff);
+	xgi_and_or(priv, VGA_SEQ_I, 0x35, ~0x07, vrs >> 8);
+}
+
+static void xgi_fix_crt1(struct xgi_priv *priv,
+			 const struct xgi_ref_rate *rate)
+{
+	const struct xgi_crt1_fix *fix;
+	int i;
+
+	xgi_and(priv, VGA_CRT_IC, 0x11, 0x7f);
+
+	for (i = 0; i < ARRAY_SIZE(xgi_crt1_fixes); i++) {
+		fix = &xgi_crt1_fixes[i];
+		if (fix->mode_id != priv->mode_no ||
+		    (fix->crt1_crtc != 0xff && fix->crt1_crtc != rate->crt1_crtc))
+			continue;
+
+		xgi_set(priv, VGA_CRT_IC, 0x02, fix->cr02);
+		xgi_set(priv, VGA_CRT_IC, 0x03, fix->cr03);
+		xgi_set(priv, VGA_CRT_IC, 0x15, fix->cr15);
+		xgi_set(priv, VGA_CRT_IC, 0x16, fix->cr16);
+		break;
+	}
+}
+
+static void xgi_set_digital_out(struct xgi_priv *priv,
+				const struct xgi_ref_rate *rate)
+{
+	u8 cr37;
+
+	xgi_set(priv, VGA_CRT_IC, 0x2e, 0x00);
+	xgi_set(priv, VGA_CRT_IC, 0x2f, 0x00);
+	xgi_set(priv, VGA_CRT_IC, 0x46, 0x00);
+	xgi_set(priv, VGA_CRT_IC, 0x47, 0x00);
+
+	cr37 = xgi_get(priv, VGA_CRT_IC, 0x37);
+	if (!(cr37 & 0x03)) {
+		xgi_set(priv, VGA_CRT_IC, 0x46, 0x13);
+		xgi_set(priv, VGA_CRT_IC, 0x47, 0x13);
+	}
+
+	/* CR37[1:0]: 0 dual 12 bit, 1 18 bit, 2 single 24 bit */
+	cr37 = (xgi_get(priv, VGA_CRT_IC, 0x37) & 0x03) << 6;
+	xgi_and_or(priv, VGA_SEQ_I, 0x06, ~0xc0, cr37 & 0x80);
+	xgi_and_or(priv, VGA_SEQ_I, 0x09, ~0xc0, cr37 | 0x80);
+
+	xgi_or(priv, VGA_SEQ_I, 0x1e, 0x01);
+
+	xgi_and(priv, VGA_SEQ_I, 0x30, ~0x20);
+	xgi_and(priv, VGA_SEQ_I, 0x35, ~0x80);
+	if (rate->info_flag & HSYNC_NEGATIVE)
+		xgi_or(priv, VGA_SEQ_I, 0x30, 0x20);
+	if (rate->info_flag & VSYNC_NEGATIVE)
+		xgi_or(priv, VGA_SEQ_I, 0x35, 0x80);
+}
+
+static void xgi_set_crt1_fifo(struct xgi_priv *priv)
+{
+	xgi_and(priv, VGA_SEQ_I, 0x3d, 0xfe);
+	xgi_set(priv, VGA_SEQ_I, 0x08, 0x34);
+	xgi_and_or(priv, VGA_SEQ_I, 0x09, 0xc0, 0x30);
+	xgi_or(priv, VGA_SEQ_I, 0x3d, 0x01);
+}
+
+static void xgi_set_crt1_mode_regs(struct xgi_priv *priv,
+				   const struct xgi_ref_rate *rate)
+{
+	u16 flag = priv->ext->mode_flag;
+	u16 xres = xgi_mode_res[priv->ext->res_info].htotal;
+	u8 data;
+
+	if (xgi_get(priv, VGA_CRT_IC, 0x31) & 0x01)
+		xgi_and(priv, VGA_SEQ_I, 0x1f, 0x3f);
+
+	data = 0x02 | (priv->mode_type - MODE_VGA) << 2;
+	if (rate->info_flag & INTERLACE_MODE)
+		data |= 0x20;
+	xgi_and_or(priv, VGA_SEQ_I, 0x06, ~0x3f, data);
+
+	data = 0;
+	if (rate->info_flag & INTERLACE_MODE) {
+		if (xres == 1024)
+			data = 0x35;
+		else if (xres == 1280)
+			data = 0x48;
+	}
+	xgi_or(priv, VGA_CRT_IC, 0x19, data);
+	xgi_and(priv, VGA_CRT_IC, 0x19, 0xfc);
+
+	if (flag & HALF_DCLK)
+		xgi_and_or(priv, VGA_SEQ_I, 0x01, 0xf7, 0x08);
+	xgi_and_or(priv, VGA_SEQ_I, 0x0f, ~0x48,
+		   flag & LINE_COMPARE_OFF ? 0x08 : 0);
+	xgi_and_or(priv, VGA_SEQ_I, 0x21, 0x1f, 0xa0);
+
+	data = xgi_get(priv, VGA_SEQ_I, 0x32) & 0xf3;
+	if (xgi_vclks[rate->crt_vclk].clock >= 200)
+		data |= 0x0c;
+	xgi_set(priv, VGA_SEQ_I, 0x32, data & ~0x04);
+	xgi_and(priv, VGA_SEQ_I, 0x07, 0xfc);
+	xgi_and(priv, VGA_SEQ_I, 0x40, 0xfc);
+
+	if (xgi_get(priv, VGA_CRT_IC, 0x31) & 0x40)
+		xgi_set(priv, VGA_CRT_IC, 0x52, 0x2c);
+	else
+		xgi_set(priv, VGA_CRT_IC, 0x52, 0x6c);
+	xgi_or(priv, VGA_CRT_IC, 0x51, 0x10);
+}
+
+static void xgi_write_dac(struct xgi_priv *priv, int dl, u8 ah, u8 al, u8 dh)
+{
+	u8 bh = ah, bl = al, tmp;
+
+	if (dl) {
+		tmp = bh;
+		bh = dh;
+		dh = tmp;
+		if (dl == 1) {
+			tmp = bl;
+			bl = dh;
+			dh = tmp;
+		} else {
+			tmp = bl;
+			bl = bh;
+			bh = tmp;
+		}
+	}
+	xgi_out(priv, VGA_PEL_D, dh);
+	xgi_out(priv, VGA_PEL_D, bh);
+	xgi_out(priv, VGA_PEL_D, bl);
+}
+
+static void xgi_load_dac(struct xgi_priv *priv)
+{
+	const u8 *t = xgi_vga_dac;
+	int i, k, m, n, o, si, di, bx;
+	u8 data, val;
+
+	xgi_out(priv, VGA_PEL_MSK, 0xff);
+	xgi_out(priv, VGA_PEL_IW, 0x00);
+
+	for (i = 0; i < 16; i++) {
+		data = t[i];
+		for (k = 0; k < 3; k++) {
+			val = 0;
+			if (data & 0x01)
+				val = 0x2a;
+			if (data & 0x02)
+				val += 0x15;
+			xgi_out(priv, VGA_PEL_D, val);
+			data >>= 2;
+		}
+	}
+
+	for (i = 16; i < 32; i++)
+		for (k = 0; k < 3; k++)
+			xgi_out(priv, VGA_PEL_D, t[i]);
+
+	si = 32;
+	for (m = 0; m < 9; m++) {
+		di = si;
+		bx = si + 4;
+		for (n = 0; n < 3; n++) {
+			for (o = 0; o < 5; o++, si++)
+				xgi_write_dac(priv, n, t[di], t[bx], t[si]);
+			si -= 2;
+			for (o = 0; o < 3; o++, si--)
+				xgi_write_dac(priv, n, t[di], t[si], t[bx]);
+		}
+		si += 5;
+	}
+}
+
+static void xgi_set_crt1(struct xgi_priv *priv)
+{
+	const struct xgi_ref_rate *rate;
+
+	xgi_set_std_regs(priv);
+	if (!priv->lvds)
+		xgi_set_default_vclk(priv);
+
+	rate = xgi_find_rate(priv);
+	xgi_out(priv, VGA_MIS_W, 0x2f | ((rate->info_flag >> 8) & 0xc0));
+	xgi_set_crt1_crtc(priv, rate);
+	xgi_set_crt1_de(priv, rate);
+	xgi_set_crt1_offset(priv, rate);
+	xgi_set_crt1_vclk(priv, rate);
+
+	if (xgi_get(priv, VGA_CRT_IC, 0x38) & 0xa0) {
+		xgi_set_xg27_crtc(priv, rate);
+		xgi_fix_crt1(priv, rate);
+		xgi_set_digital_out(priv, rate);
+	}
+
+	xgi_set_crt1_fifo(priv);
+	xgi_set_crt1_mode_regs(priv, rate);
+	xgi_load_dac(priv);
+}
+
+static int xgi_set_mode_no(struct xgi_priv *priv, u8 mode_no)
+{
+	const struct xgi_ext_mode *ext;
+
+	priv->lvds = (xgi_get(priv, VGA_CRT_IC, 0x38) & 0xe0) == 0xc0 &&
+		     (xgi_get(priv, VGA_CRT_IC, 0x30) & 0x20);
+	if (priv->lvds)
+		log_warning("LVDS panels are not supported\n");
+
+	xgi_set(priv, VGA_SEQ_I, 0x05, XGI_PASSWORD);
+
+	for (ext = xgi_ext_modes; ext->mode_id != mode_no; ext++)
+		if (ext->mode_id == 0xff)
+			return -EINVAL;
+
+	priv->ext = ext;
+	priv->mode_no = mode_no;
+	priv->mode_type = ext->mode_flag & MODE_TYPE_MASK;
+
+	xgi_display_off(priv);
+	xgi_set_crt1(priv);
+	xgi_display_on(priv);
+
+	return 0;
+}
+
+static void xgi_set_memory_clock(struct xgi_priv *priv)
+{
+	const struct xgi_mclk *mclk = &xg27_mclk[priv->ram_type];
+	const struct xgi_eclk *eclk = &xg27_eclk[priv->ram_type];
+
+	xgi_set(priv, VGA_SEQ_I, 0x28, mclk->sr28);
+	xgi_set(priv, VGA_SEQ_I, 0x29, mclk->sr29);
+	xgi_set(priv, VGA_SEQ_I, 0x2a, mclk->sr2a);
+	xgi_set(priv, VGA_SEQ_I, 0x2e, eclk->sr2e);
+	xgi_set(priv, VGA_SEQ_I, 0x2f, eclk->sr2f);
+	xgi_set(priv, VGA_SEQ_I, 0x30, eclk->sr30);
+}
+
+static void xgi_dram_cmd(struct xgi_priv *priv, u8 sr18, u8 sr19, u8 sr16)
+{
+	xgi_set(priv, VGA_SEQ_I, 0x18, sr18);
+	xgi_set(priv, VGA_SEQ_I, 0x19, sr19);
+	xgi_set(priv, VGA_SEQ_I, 0x16, sr16);
+}
+
+static void xgi_ddr1_init(struct xgi_priv *priv)
+{
+	u8 sr18 = xg27_sr18[priv->ram_type];
+
+	xgi_set_memory_clock(priv);
+	xgi_set(priv, VGA_CRT_IC, 0x82, xg27_cr40[11][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x85, xg27_cr40[12][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x86, xg27_cr40[13][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x98, 0x01);
+	xgi_set(priv, VGA_CRT_IC, 0x9a, 0x02);
+
+	xgi_dram_cmd(priv, 0x01, 0x40, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x80);
+	udelay(60);
+	xgi_dram_cmd(priv, 0x00, 0x40, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x80);
+	udelay(60);
+	xgi_dram_cmd(priv, sr18, 0x01, 0x03);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x83);
+	udelay(1);
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x03);
+	udelay(500);
+	xgi_dram_cmd(priv, sr18, 0x00, 0x03);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x83);
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x00);
+}
+
+static void xgi_ddr2_init(struct xgi_priv *priv)
+{
+	/* keep the sequence, the dummy reads give the controller idle time */
+	xgi_set(priv, VGA_CRT_IC, 0x82, 0x77);
+	xgi_set(priv, VGA_CRT_IC, 0x86, 0x00);
+	xgi_get(priv, VGA_CRT_IC, 0x86);
+	xgi_set(priv, VGA_CRT_IC, 0x86, 0x88);
+	xgi_get(priv, VGA_CRT_IC, 0x86);
+	xgi_set(priv, VGA_CRT_IC, 0x86, xg27_cr40[13][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x82, 0x77);
+	xgi_set(priv, VGA_CRT_IC, 0x85, 0x00);
+	xgi_get(priv, VGA_CRT_IC, 0x85);
+	xgi_set(priv, VGA_CRT_IC, 0x85, 0x88);
+	xgi_get(priv, VGA_CRT_IC, 0x85);
+	xgi_set(priv, VGA_CRT_IC, 0x85, xg27_cr40[12][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x82, xg27_cr40[11][priv->ram_type]);
+	xgi_set(priv, VGA_CRT_IC, 0x98, 0x01);
+	xgi_set(priv, VGA_CRT_IC, 0x9a, 0x02);
+
+	xgi_set_memory_clock(priv);
+	xgi_set(priv, VGA_CRT_IC, 0x97, priv->cr97);
+	udelay(200);
+
+	/* EMRS2 */
+	xgi_dram_cmd(priv, 0x00, 0x80, 0x20);
+	udelay(15);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0xa0);
+	udelay(15);
+	/* EMRS3 */
+	xgi_dram_cmd(priv, 0x00, 0xc0, 0x20);
+	udelay(15);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0xa0);
+	udelay(15);
+	/* EMRS1 */
+	xgi_dram_cmd(priv, 0x00, 0x40, 0x20);
+	udelay(30);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0xa0);
+	udelay(15);
+	/* MRS, DLL enable */
+	xgi_dram_cmd(priv, 0x42, 0x0a, 0x00);
+	udelay(30);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x80);
+
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x04);
+	udelay(60);
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x00);
+
+	/* MRS, DLL reset */
+	xgi_dram_cmd(priv, 0x42, 0x08, 0x00);
+	udelay(30);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0x83);
+	udelay(15);
+	/* MRS, ODT */
+	xgi_dram_cmd(priv, 0x80, 0x46, 0x20);
+	udelay(30);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0xa0);
+	udelay(15);
+	/* EMRS */
+	xgi_dram_cmd(priv, 0x00, 0x40, 0x20);
+	udelay(30);
+	xgi_set(priv, VGA_SEQ_I, 0x16, 0xa0);
+	udelay(15);
+
+	/* refresh on */
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x04);
+	udelay(200);
+}
+
+static void xgi_dram_delays(struct xgi_priv *priv, u8 reg, u8 seed, u8 val,
+			    u8 shift, u8 mask, u8 step)
+{
+	int j;
+
+	for (j = 0; j < 4; j++) {
+		val |= ((seed >> (2 * j)) & 0x03) << shift;
+		xgi_set(priv, VGA_CRT_IC, reg, val);
+		xgi_get(priv, VGA_CRT_IC, reg);
+		val &= mask;
+		val += step;
+	}
+}
+
+static void xgi_dram_default_regs(struct xgi_priv *priv)
+{
+	int rt = priv->ram_type;
+	u8 val;
+	int i;
+
+	xgi_set(priv, VGA_CRT_IC, 0x6d, xg27_cr40[8][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x68, xg27_cr40[5][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x69, xg27_cr40[6][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x6a, xg27_cr40[7][rt]);
+
+	/* DQS and DQM fine tune delays */
+	xgi_dram_delays(priv, 0x6b, 0xaa, 0, 2, 0xf0, 0x10);
+	xgi_dram_delays(priv, 0x6e, 0, 0, 2, 0xf0, 0x10);
+	for (i = 0; i < 4; i++) {
+		xgi_and_or(priv, VGA_CRT_IC, 0x6e, 0xfc, i);
+		xgi_dram_delays(priv, 0x6f, 0, 0, 0, 0xf8, 0x08);
+	}
+
+	xgi_set(priv, VGA_CRT_IC, 0x80, xg27_cr40[9][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x81, xg27_cr40[10][rt]);
+
+	/* terminator type */
+	xgi_dram_delays(priv, 0x89, 0, 0x80, 0, 0xf0, 0x10);
+	xgi_set(priv, VGA_CRT_IC, 0x89, 0x80);
+
+	val = xg27_cr40[3][rt];
+	xgi_set(priv, VGA_CRT_IC, 0x45, val & 0x0f);
+	xgi_set(priv, VGA_CRT_IC, 0x99, (val >> 4) & 0x07);
+	xgi_or(priv, VGA_CRT_IC, 0x40, val & 0x80);
+	xgi_set(priv, VGA_CRT_IC, 0x41, xg27_cr40[0][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x8f, 0x0c);
+
+	for (i = 0; i <= 6; i++)
+		xgi_set(priv, VGA_CRT_IC, 0x90 + i, xg27_cr40[14 + i][rt]);
+	for (i = 0; i <= 2; i++)
+		xgi_set(priv, VGA_CRT_IC, 0xc3 + i, xg27_cr40[21 + i][rt]);
+	for (i = 0; i < 2; i++)
+		xgi_set(priv, VGA_CRT_IC, 0x8a + i, xg27_cr40[1 + i][rt]);
+
+	xgi_set(priv, VGA_CRT_IC, 0x59, xg27_cr40[4][rt]);
+	xgi_set(priv, VGA_CRT_IC, 0x83, 0x09);
+	xgi_set(priv, VGA_CRT_IC, 0x87, 0x00);
+	xgi_set(priv, VGA_CRT_IC, 0xcf, 0x13);
+
+	if (rt) {
+		xgi_set(priv, VGA_SEQ_I, 0x17, 0x80);
+		xgi_set(priv, VGA_SEQ_I, 0x17, 0x02);
+	} else {
+		xgi_set(priv, VGA_SEQ_I, 0x17, 0x00);
+	}
+	xgi_set(priv, VGA_SEQ_I, 0x1a, 0x87);
+
+	if (rt) {
+		xgi_set(priv, VGA_CRT_IC, 0xb0, 0x80);
+		xgi_ddr2_init(priv);
+	} else {
+		xgi_ddr1_init(priv);
+	}
+	xgi_set(priv, VGA_SEQ_I, 0x1b, 0x03);
+}
+
+static bool xgi_vram_test(struct xgi_priv *priv, int stop, int start)
+{
+	int i;
+
+	writel(0, priv->fb);
+	for (i = start; i <= stop; i++)
+		writel(BIT(i), priv->fb + BIT(i));
+
+	udelay(500);
+
+	if (readl(priv->fb))
+		return false;
+	for (i = start; i <= stop; i++)
+		if (readl(priv->fb + BIT(i)) != BIT(i))
+			return false;
+
+	return true;
+}
+
+static void xgi_dram_sizing(struct xgi_priv *priv)
+{
+	const struct xgi_dram_type *type;
+	int bits, rank, i;
+
+	xgi_set(priv, VGA_SEQ_I, 0x15, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x1c, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x14, 0x51);
+
+	for (i = 0; i < ARRAY_SIZE(xgi_dram_types); i++) {
+		type = &xgi_dram_types[i];
+		xgi_and_or(priv, VGA_SEQ_I, 0x13, 0x80, type->sr13);
+		udelay(50);
+
+		rank = type->size * 16 / 8;
+		if (xgi_get(priv, VGA_SEQ_I, 0x13) & 0x80)
+			rank *= 2;
+		if (rank > 256)
+			continue;
+
+		bits = 0;
+		while ((rank >>= 1) > 0)
+			bits++;
+		xgi_and_or(priv, VGA_SEQ_I, 0x14, 0x0f, bits << 4);
+		udelay(15);
+		if (!bits)
+			continue;
+
+		bits += 19;
+		if (priv->fb_size - 1 < BIT(bits))
+			continue;
+
+		if (xgi_vram_test(priv, bits, 5))
+			return;
+	}
+}
+
+static void xgi_chk_sense_status(struct xgi_priv *priv)
+{
+	u8 cr32 = xgi_get(priv, VGA_CRT_IC, 0x32);
+	u16 active = 0, mask;
+
+	if (cr32 & MONITOR1_SENSE)
+		active |= ACTIVE_CRT1;
+	if (cr32 & LCD_SENSE)
+		active |= ACTIVE_LCD;
+	if (cr32 & MONITOR2_SENSE)
+		active |= ACTIVE_CRT2;
+	if (cr32 & TV_SENSE) {
+		active |= ACTIVE_TV;
+		if (cr32 & AVIDEO_SENSE)
+			active |= ACTIVE_AVIDEO;
+		if (cr32 & SVIDEO_SENSE)
+			active |= ACTIVE_SVIDEO;
+		if (cr32 & SCART_SENSE)
+			active |= ACTIVE_SCART;
+		if (cr32 & HITV_SENSE)
+			active |= ACTIVE_HITV;
+		if (cr32 & YPBPR_SENSE)
+			active |= ACTIVE_YPBPR;
+	}
+
+	mask = xgi_get(priv, VGA_CRT_IC, 0x3d) |
+	       xgi_get(priv, VGA_CRT_IC, 0x3e) << 8;
+	if (!(active & mask) ||
+	    !(xgi_get(priv, VGA_CRT_IC, 0x3c) & DISPLAY_FROM_CMOS))
+		mask = 0x1ff0;
+
+	active &= mask;
+	xgi_set(priv, VGA_CRT_IC, 0x3d, active & 0xff);
+	xgi_set(priv, VGA_CRT_IC, 0x3e, active >> 8);
+}
+
+static u16 xgi_tv_outputs(u16 active)
+{
+	u16 cr30 = 0;
+
+	if (active & ACTIVE_AVIDEO)
+		cr30 |= SET_CRT2_TO_AVIDEO;
+	if (active & ACTIVE_SVIDEO)
+		cr30 |= SET_CRT2_TO_SVIDEO;
+	if (active & ACTIVE_SCART)
+		cr30 |= SET_CRT2_TO_SCART;
+
+	return cr30;
+}
+
+static void xgi_set_mode_scratch(struct xgi_priv *priv)
+{
+	u16 active, cr30 = 0;
+	u8 cr31, cr38 = 0;
+
+	active = xgi_get(priv, VGA_CRT_IC, 0x3d) |
+		 xgi_get(priv, VGA_CRT_IC, 0x3e) << 8 |
+		 (xgi_get(priv, VGA_CRT_IC, 0x31) & (DRIVER_MODE >> 8)) << 8;
+
+	if (active & ACTIVE_LCD) {
+		cr30 |= SET_CRT2_TO_LCD;
+		if ((active & DRIVER_MODE) && (active & ACTIVE_TV)) {
+			cr38 = SET_TO_LCDA | ENABLE_DUAL_EDGE;
+			active ^= SET_CRT2_TO_LCD;
+			cr30 |= xgi_tv_outputs(active);
+		}
+	} else {
+		cr30 |= xgi_tv_outputs(active);
+	}
+
+	cr30 |= SET_SIMU_SCAN_MODE;
+	if (!(active & ACTIVE_CRT1) &&
+	    (active & (ACTIVE_LCD | ACTIVE_TV | ACTIVE_CRT2)))
+		cr30 ^= SET_SIMU_SCAN_MODE | SWITCH_CRT2;
+	if ((active & ACTIVE_LCD) && (active & ACTIVE_TV))
+		cr30 ^= SET_SIMU_SCAN_MODE | SWITCH_CRT2;
+	xgi_set(priv, VGA_CRT_IC, 0x30, cr30);
+
+	cr31 = xgi_get(priv, VGA_CRT_IC, 0x31);
+	cr31 &= ~(SET_NOT_SIMU_MODE >> 8);
+	if (!(active & ACTIVE_CRT1))
+		cr31 |= SET_NOT_SIMU_MODE >> 8;
+	cr31 &= ~(DISABLE_CRT2_DISPLAY >> 8);
+	if (!(active & (ACTIVE_LCD | ACTIVE_TV | ACTIVE_CRT2)))
+		cr31 |= DISABLE_CRT2_DISPLAY >> 8;
+	xgi_set(priv, VGA_CRT_IC, 0x31, cr31);
+
+	xgi_and_or(priv, VGA_CRT_IC, 0x38, ~SET_YPBPR, cr38);
+}
+
+/* XG27 GPIO A-C straps tell an LVDS panel from TMDS/DVO */
+static void xgi_sense_outputs(struct xgi_priv *priv)
+{
+	u8 cr4a = xgi_get(priv, VGA_CRT_IC, 0x4a);
+	u8 straps;
+
+	xgi_and_or(priv, VGA_CRT_IC, 0x4a, ~0x07, 0x07);
+	straps = xgi_get(priv, VGA_CRT_IC, 0x48) & 0x07;
+	xgi_set(priv, VGA_CRT_IC, 0x4a, cr4a);
+
+	if (straps <= 0x02) {
+		xgi_and_or(priv, VGA_CRT_IC, 0x38, ~0xe0, 0xc0);
+		xgi_set(priv, VGA_CRT_IC, 0x30, 0x21);
+	} else {
+		xgi_and_or(priv, VGA_CRT_IC, 0x38, ~0xe0, 0xa0);
+	}
+	xgi_or(priv, VGA_CRT_IC, 0x32, LCD_SENSE);
+}
+
+static u8 xgi_fp_bits(struct xgi_priv *priv)
+{
+	u8 cr4a = xgi_get(priv, VGA_CRT_IC, 0x4a);
+	u8 val;
+
+	xgi_and_or(priv, VGA_CRT_IC, 0x4a, ~0x03, 0x03);
+	val = xgi_get(priv, VGA_CRT_IC, 0x48);
+	if (val > 2)
+		val = ((val & 0x04) >> 1) | (~val & 0x01);
+	xgi_set(priv, VGA_CRT_IC, 0x4a, cr4a);
+
+	return val;
+}
+
+/* DAC load test on CRT1, the result lands in CR32[5] */
+static void xgi_sense_crt1(struct xgi_priv *priv)
+{
+	static const u8 crtc[17] = {
+		0x5f, 0x4f, 0x50, 0x82, 0x55, 0x81, 0x0b, 0x3e,
+		0xe9, 0x0b, 0xdf, 0xe7, 0x04, 0x00, 0x00, 0x05,
+		0x00
+	};
+	u8 sr01, sr1f, sr07, sr06, sr31, cr17, cr63;
+	int i;
+
+	xgi_set(priv, VGA_SEQ_I, 0x05, XGI_PASSWORD);
+	xgi_set(priv, VGA_CRT_IC, 0x57, 0x4a);
+	xgi_or(priv, VGA_CRT_IC, 0x53, 0x02);
+
+	sr31 = xgi_get(priv, VGA_SEQ_I, 0x31);
+	cr63 = xgi_get(priv, VGA_CRT_IC, 0x63);
+	sr01 = xgi_get(priv, VGA_SEQ_I, 0x01);
+	xgi_set(priv, VGA_SEQ_I, 0x01, sr01 & 0xdf);
+	xgi_set(priv, VGA_CRT_IC, 0x63, cr63 & 0xbf);
+
+	cr17 = xgi_get(priv, VGA_CRT_IC, 0x17);
+	xgi_set(priv, VGA_CRT_IC, 0x17, cr17 | 0x80);
+	sr1f = xgi_get(priv, VGA_SEQ_I, 0x1f);
+	xgi_set(priv, VGA_SEQ_I, 0x1f, sr1f | 0x04);
+	sr07 = xgi_get(priv, VGA_SEQ_I, 0x07);
+	xgi_set(priv, VGA_SEQ_I, 0x07, sr07 & 0xfb);
+	sr06 = xgi_get(priv, VGA_SEQ_I, 0x06);
+	xgi_set(priv, VGA_SEQ_I, 0x06, sr06 & 0xc3);
+
+	xgi_set(priv, VGA_CRT_IC, 0x11, 0x00);
+	for (i = 0; i < 8; i++)
+		xgi_set(priv, VGA_CRT_IC, i, crtc[i]);
+	for (i = 8; i < 11; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 8, crtc[i]);
+	for (i = 11; i < 13; i++)
+		xgi_set(priv, VGA_CRT_IC, i + 4, crtc[i]);
+	for (i = 13; i < 16; i++)
+		xgi_set(priv, VGA_SEQ_I, i - 3, crtc[i]);
+	xgi_set(priv, VGA_SEQ_I, 0x0e, crtc[16] & 0xe0);
+
+	xgi_set(priv, VGA_SEQ_I, 0x31, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x2b, 0x1b);
+	xgi_set(priv, VGA_SEQ_I, 0x2c, 0xe1);
+
+	xgi_out(priv, VGA_PEL_IW, 0x00);
+	for (i = 0; i < 256 * 3; i++)
+		xgi_out(priv, VGA_PEL_D, 0x0f);
+
+	mdelay(1);
+
+	xgi_in(priv, VGA_IS1_RC);
+	xgi_in(priv, VGA_IS1_RC);
+	if (xgi_in(priv, VGA_IS0_R) & 0x10)
+		xgi_and_or(priv, VGA_CRT_IC, 0x32, 0xdf, 0x20);
+	else
+		xgi_and(priv, VGA_CRT_IC, 0x32, 0xdf);
+
+	xgi_out(priv, VGA_PEL_IW, 0x00);
+	for (i = 0; i < 256 * 3; i++)
+		xgi_out(priv, VGA_PEL_D, 0x00);
+
+	xgi_set(priv, VGA_SEQ_I, 0x01, sr01);
+	xgi_set(priv, VGA_CRT_IC, 0x63, cr63);
+	xgi_set(priv, VGA_SEQ_I, 0x31, sr31);
+	xgi_and(priv, VGA_CRT_IC, 0x53, 0xfd);
+	xgi_set(priv, VGA_SEQ_I, 0x1f, sr1f);
+}
+
+static int xgi_post(struct xgi_priv *priv)
+{
+	int ret, i;
+
+	xgi_out(priv, VGA_MIS_W, 0x67);
+	priv->cr97 = xgi_strapped_ddr(priv) ? 0x80 : 0xc1;
+	xgi_set(priv, VGA_SEQ_I, 0x05, XGI_PASSWORD);
+	xgi_sense_outputs(priv);
+
+	for (i = 0x06; i < 0x20; i++)
+		xgi_set(priv, VGA_SEQ_I, i, 0);
+	for (i = 0x21; i <= 0x27; i++)
+		xgi_set(priv, VGA_SEQ_I, i, 0);
+	for (i = 0x31; i <= 0x3b; i++)
+		xgi_set(priv, VGA_SEQ_I, i, 0);
+	for (i = 0x79; i <= 0x7c; i++)
+		xgi_set(priv, VGA_CRT_IC, i, 0);
+	xgi_set(priv, VGA_CRT_IC, 0x97, priv->cr97);
+
+	xgi_set(priv, VGA_SEQ_I, 0x07, 0x18);
+	xgi_set(priv, VGA_SEQ_I, 0x40, 0x04);
+	xgi_set(priv, VGA_SEQ_I, 0x41, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x11, 0x0f);
+	xgi_set(priv, VGA_SEQ_I, 0x1f, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x20, 0xa0);
+	xgi_set(priv, VGA_SEQ_I, 0x36, 0x70);
+	xgi_set(priv, VGA_SEQ_I, 0x36, 0x30);
+	xgi_set(priv, VGA_SEQ_I, 0x23, 0xf6);
+	xgi_set(priv, VGA_SEQ_I, 0x24, 0x0d);
+	xgi_set(priv, VGA_SEQ_I, 0x25, 0x00);
+	xgi_set(priv, VGA_SEQ_I, 0x27, 0x1f);
+	xgi_set(priv, VGA_SEQ_I, 0x31, 0xc0);
+	xgi_set(priv, VGA_SEQ_I, 0x32, 0x11);
+	xgi_set(priv, VGA_SEQ_I, 0x33, 0x00);
+
+	xgi_sense_crt1(priv);
+	xgi_or(priv, VGA_CRT_IC, 0x32, MONITOR1_SENSE);
+	xgi_and_or(priv, VGA_CRT_IC, 0x37, ~0x03, xgi_fp_bits(priv));
+
+	priv->ram_type = xgi_strapped_ddr(priv) ? 0 : 1;
+	xgi_dram_default_regs(priv);
+
+	ret = xgi_set_mode_no(priv, 0x2e);
+	if (ret)
+		return ret;
+	xgi_and(priv, VGA_SEQ_I, 0x21, 0xdf);
+	xgi_display_off(priv);
+	xgi_dram_sizing(priv);
+	xgi_or(priv, VGA_SEQ_I, 0x21, 0x20);
+
+	xgi_set(priv, VGA_SEQ_I, 0x22, 0xfa);
+	xgi_set(priv, VGA_SEQ_I, 0x21, 0xa3);
+
+	xgi_chk_sense_status(priv);
+	xgi_set_mode_scratch(priv);
+	xgi_set(priv, VGA_CRT_IC, 0x8c, 0x87);
+
+	return 0;
+}
+
+static int xgi_set_mode(struct xgi_priv *priv, const struct xgi_mode *mode)
+{
+	u16 pitch = mode->xres * mode->bpp / 64;
+	u8 cr31;
+	int ret;
+
+	cr31 = xgi_get(priv, VGA_CRT_IC, 0x31) & ~0x60;
+	xgi_set(priv, VGA_CRT_IC, 0x30, 0x00);
+	xgi_set(priv, VGA_CRT_IC, 0x31, cr31 | 0x60);
+	xgi_set(priv, VGA_CRT_IC, 0x33, mode->rate);
+
+	ret = xgi_set_mode_no(priv, mode->mode_no);
+	if (ret)
+		return ret;
+
+	/* xgifb writes the whole SR0E here, its timing bits end up cleared */
+	xgi_set(priv, VGA_SEQ_I, 0x05, XGI_PASSWORD);
+	xgi_set(priv, VGA_CRT_IC, 0x13, pitch & 0xff);
+	xgi_set(priv, VGA_SEQ_I, 0x0e, pitch >> 8);
+
+	xgi_or(priv, VGA_CRT_IC, 0x17, 0x80);
+	xgi_and(priv, VGA_SEQ_I, 0x07, ~0x04);
+
+	return 0;
+}
+
+/*
+ * xgi-fb in Linux keeps off the I/O BAR and can't read the mode back.
+ * Leave it in the last 4 KiB of VRAM: magic, width, height, bpp, pitch.
+ */
+static void xgi_save_mode(struct xgi_priv *priv, const struct xgi_mode *mode)
+{
+	void __iomem *info = priv->fb + priv->fb_size - XGI_MODE_INFO_SIZE;
+
+	writel(mode->xres, info + 4);
+	writel(mode->yres, info + 8);
+	writel(mode->bpp, info + 12);
+	writel(mode->xres * mode->bpp / 8, info + 16);
+	writel(XGI_MODE_INFO_MAGIC, info);
+}
+
+static int xgi_lookup_mode(struct xgi_mode *mode)
+{
+	const struct xgi_ext_mode *ext;
+	const struct xgi_mode_res *res;
+	u16 type;
+	int i;
+
+	if (mode->bpp == 16)
+		type = MODE_16BPP;
+	else if (mode->bpp == 32)
+		type = MODE_32BPP;
+	else
+		return -EINVAL;
+
+	for (ext = xgi_ext_modes; ext->mode_id != 0xff; ext++) {
+		res = &xgi_mode_res[ext->res_info];
+		if (res->htotal == mode->xres && res->vtotal == mode->yres &&
+		    (ext->mode_flag & MODE_TYPE_MASK) == type &&
+		    !(ext->mode_flag & (HALF_DCLK | DOUBLE_SCAN_MODE)))
+			break;
+	}
+	if (ext->mode_id == 0xff)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(xgi_rates); i++)
+		if (xgi_rates[i].xres == mode->xres &&
+		    xgi_rates[i].yres == mode->yres &&
+		    xgi_rates[i].refresh == mode->refresh)
+			break;
+	if (i == ARRAY_SIZE(xgi_rates))
+		return -EINVAL;
+
+	mode->mode_no = ext->mode_id;
+	mode->rate = xgi_rates[i].index;
+
+	return 0;
+}
+
+/* "video-mode" from envs */
+static int xgi_get_mode(struct xgi_mode *mode)
+{
+	uint xres, yres, depth, freq;
+	const char *options;
+
+	if (video_get_video_mode(&xres, &yres, &depth, &freq, &options)) {
+		mode->xres = xres;
+		mode->yres = yres;
+		mode->bpp = depth;
+		mode->refresh = freq;
+		if (!xgi_lookup_mode(mode))
+			return 0;
+		log_warning("xgi: unsupported video-mode %ux%u-%u@%u\n",
+			    xres, yres, depth, freq);
+	}
+
+	mode->xres = CONFIG_VIDEO_XGI_SIZE_X;
+	mode->yres = CONFIG_VIDEO_XGI_SIZE_Y;
+	mode->bpp = CONFIG_VIDEO_XGI_BPP;
+	mode->refresh = 60;
+
+	return xgi_lookup_mode(mode);
+}
+
+static ulong xgi_bar_size(struct udevice *dev, int bar)
+{
+	u32 addr, mask;
+	u16 cmd;
+
+	dm_pci_read_config16(dev, PCI_COMMAND, &cmd);
+	dm_pci_write_config16(dev, PCI_COMMAND, cmd & ~PCI_COMMAND_MEMORY);
+	dm_pci_read_config32(dev, bar, &addr);
+	dm_pci_write_config32(dev, bar, 0xffffffff);
+	dm_pci_read_config32(dev, bar, &mask);
+	dm_pci_write_config32(dev, bar, addr);
+	dm_pci_write_config16(dev, PCI_COMMAND, cmd);
+
+	return ~(mask & PCI_BASE_ADDRESS_MEM_MASK) + 1;
+}
+
+static int xgi_video_probe(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct xgi_priv *priv = dev_get_priv(dev);
+	const struct xgi_mode *mode = dev_get_plat(dev);
+	int ret;
+
+	priv->fb_size = xgi_bar_size(dev, PCI_BASE_ADDRESS_0);
+	priv->io = dm_pci_map_bar(dev, PCI_BASE_ADDRESS_2, 0, 0,
+				  PCI_REGION_TYPE, PCI_REGION_IO);
+	priv->fb = dm_pci_map_bar(dev, PCI_BASE_ADDRESS_0, 0, 0,
+				  PCI_REGION_TYPE, PCI_REGION_MEM);
+	if (!priv->io || !priv->fb)
+		return log_msg_ret("bar", -EIO);
+
+	xgi_set(priv, VGA_SEQ_I, 0x05, XGI_PASSWORD);
+	if (xgi_get(priv, VGA_SEQ_I, 0x05) != XGI_PASSWORD_OK)
+		return log_msg_ret("io", -EIO);
+
+	/* linear addressing, MMIO and the 2D engine */
+	xgi_or(priv, VGA_SEQ_I, 0x20, 0x81);
+	xgi_or(priv, VGA_SEQ_I, 0x1e, 0x40);
+
+	ret = xgi_post(priv);
+	if (ret)
+		return log_msg_ret("post", ret);
+	log_debug("%s: %d MiB VRAM\n", dev->name,
+		  1 << (xgi_get(priv, VGA_SEQ_I, 0x14) >> 4));
+
+	ret = xgi_set_mode(priv, mode);
+	if (ret)
+		return log_msg_ret("set", ret);
+	xgi_save_mode(priv, mode);
+
+	uc_priv->xsize = mode->xres;
+	uc_priv->ysize = mode->yres;
+	if (mode->bpp == 32) {
+		uc_priv->bpix = VIDEO_BPP32;
+		uc_priv->format = VIDEO_X8R8G8B8;
+	} else {
+		uc_priv->bpix = VIDEO_BPP16;
+	}
+
+	if (IS_ENABLED(CONFIG_VIDEO_COPY))
+		plat->copy_base = (ulong)priv->fb;
+	else
+		plat->base = (ulong)priv->fb;
+
+	return 0;
+}
+
+static int xgi_video_bind(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct xgi_mode *mode = dev_get_plat(dev);
+	int ret;
+
+	ret = xgi_get_mode(mode);
+	if (ret)
+		return log_msg_ret("mode", ret);
+
+	plat->size = mode->xres * mode->yres * mode->bpp / 8;
+
+	return 0;
+}
+
+U_BOOT_DRIVER(xgi_video) = {
+	.name		= "xgi_video",
+	.id		= UCLASS_VIDEO,
+	.bind		= xgi_video_bind,
+	.probe		= xgi_video_probe,
+	.priv_auto	= sizeof(struct xgi_priv),
+	.plat_auto	= sizeof(struct xgi_mode),
+};
+
+static struct pci_device_id xgi_video_supported[] = {
+	{ PCI_DEVICE(0x18ca, 0x0027) },
+	{ },
+};
+
+U_BOOT_PCI_DEVICE(xgi_video, xgi_video_supported);
