diff --git a/board/promwad/wtplug_tc/kwbimage.cfg b/board/promwad/wtplug_tc/kwbimage.cfg
new file mode 100644
index 00000000000..4c43dbc1c2e
--- /dev/null
+++ b/board/promwad/wtplug_tc/kwbimage.cfg
@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# (C) Copyright 2009
+# Marvell Semiconductor <www.marvell.com>
+# Written-by: Siddarth Gore <gores@marvell.com>
+#
+# Modified-by: Viktar Palstsiuk <viktar.palstsiuk@promwad.com>
+#
+# Refer to doc/README.kwbimage for more details about how-to configure
+# and create kirkwood boot image
+#
+# Boot Media configurations
+BOOT_FROM	nand
+NAND_ECC_MODE	default
+NAND_PAGE_SIZE	0x0800
+
+# SOC registers configuration using bootrom header extension
+# Maximum KWBIMAGE_MAX_CONFIG configurations allowed
+
+# Configure RGMII-0/1 interface pad voltage to 1.8V
+DATA 0xFFD100e0 0x1b1b9b9b
+
+#Dram initalization for SINGLE x16 CL=5 @ 400MHz
+DATA 0xFFD01400 0x43000c30	# DDR Configuration register
+# bit13-0:  0xc30 (3120 DDR2 clks refresh rate)
+# bit23-14: zero
+# bit24: 1= enable exit self refresh mode on DDR access
+# bit25: 1 required
+# bit29-26: zero
+# bit31-30: 01
+
+DATA 0xFFD01404 0x37543000	# DDR Controller Control Low
+# bit 4:    0=addr/cmd in smame cycle
+# bit 5:    0=clk is driven during self refresh, we don't care for APX
+# bit 6:    0=use recommended falling edge of clk for addr/cmd
+# bit14:    0=input buffer always powered up
+# bit18:    1=cpu lock transaction enabled
+# bit23-20: 5=recommended value for CL=5 and STARTBURST_DEL disabled bit31=0
+# bit27-24: 7= CL+2, STARTBURST sample stages, for freqs 400MHz, unbuffered DIMM
+# bit30-28: 3 required
+# bit31:    0=no additional STARTBURST delay
+
+DATA 0xFFD01408 0x22125451	# DDR Timing (Low) (active cycles value +1)
+# bit3-0:   TRAS lsbs
+# bit7-4:   TRCD
+# bit11- 8: TRP
+# bit15-12: TWR
+# bit19-16: TWTR
+# bit20:    TRAS msb
+# bit23-21: 0x0
+# bit27-24: TRRD
+# bit31-28: TRTP
+
+DATA 0xFFD0140C 0x00000a33	#  DDR Timing (High)
+# bit6-0:   TRFC
+# bit8-7:   TR2R
+# bit10-9:  TR2W
+# bit12-11: TW2W
+# bit31-13: zero required
+
+DATA 0xFFD01410 0x00000000	#  DDR Address Control
+# bit1-0:   00, Cs0width=x8
+# bit3-2:   00, Cs0size=2Gb
+# bit5-4:   00, Cs1width=x8
+# bit7-6:   00, Cs1size=2Gb
+# bit9-8:   00, Cs2width=nonexistent
+# bit11-10: 00, Cs2size =nonexistent
+# bit13-12: 00, Cs3width=nonexistent
+# bit15-14: 00, Cs3size =nonexistent
+# bit16:    0,  Cs0AddrSel
+# bit17:    0,  Cs1AddrSel
+# bit18:    0,  Cs2AddrSel
+# bit19:    0,  Cs3AddrSel
+# bit31-20: 0 required
+
+DATA 0xFFD01414 0x00000000	#  DDR Open Pages Control
+# bit0:    0,  OpenPage enabled
+# bit31-1: 0 required
+
+DATA 0xFFD01418 0x00000000	#  DDR Operation
+# bit3-0:   0x0, DDR cmd
+# bit31-4:  0 required
+
+DATA 0xFFD0141C 0x00000C52	#  DDR Mode
+# bit2-0:   2, BurstLen=2 required
+# bit3:     0, BurstType=0 required
+# bit6-4:   4, CL=5
+# bit7:     0, TestMode=0 normal
+# bit8:     0, DLL reset=0 normal
+# bit11-9:  6, auto-precharge write recovery ????????????
+# bit12:    0, PD must be zero
+# bit31-13: 0 required
+
+DATA 0xFFD01420 0x00000040	#  DDR Extended Mode
+# bit0:    0,  DDR DLL enabled
+# bit1:    0,  DDR drive strenght normal
+# bit2:    0,  DDR ODT control lsd (disabled)
+# bit5-3:  000, required
+# bit6:    1,  DDR ODT control msb, (disabled)
+# bit9-7:  000, required
+# bit10:   0,  differential DQS enabled
+# bit11:   0, required
+# bit12:   0, DDR output buffer enabled
+# bit31-13: 0 required
+
+DATA 0xFFD01424 0x0000F17F	#  DDR Controller Control High
+# bit2-0:  111, required
+# bit3  :  1  , MBUS Burst Chop disabled
+# bit6-4:  111, required
+# bit7  :  0
+# bit8  :  1  , add writepath sample stage, must be 1 for DDR freq >= 300MHz
+# bit9  :  0  , no half clock cycle addition to dataout
+# bit10 :  0  , 1/4 clock cycle skew enabled for addr/ctl signals
+# bit11 :  0  , 1/4 clock cycle skew disabled for write mesh
+# bit15-12: 1111 required
+# bit31-16: 0    required
+
+DATA 0xFFD01428 0x00085520	# DDR2 ODT Read Timing (default values)
+DATA 0xFFD0147C 0x00008552	# DDR2 ODT Write Timing (default values)
+
+DATA 0xFFD01500 0x00000000	# CS[0]n Base address to 0x0
+DATA 0xFFD01504 0x1FFFFFF1	# CS[0]n Size
+# bit0:    1,  Window enabled
+# bit1:    0,  Write Protect disabled
+# bit3-2:  00, CS0 hit selected
+# bit23-4: ones, required
+# bit31-24: 0x1F, Size (i.e. 512MB)
+
+DATA 0xFFD01508 0x20000000	# CS[1]n Base address to 512Mb
+DATA 0xFFD0150C 0x1FFFFFF5	# CS[1]n Size 512Mb Window enabled for CS1
+
+DATA 0xFFD01514 0x00000000	# CS[2]n Size, window disabled
+DATA 0xFFD0151C 0x00000000	# CS[3]n Size, window disabled
+
+DATA 0xFFD01494 0x00030000	#  DDR ODT Control (Low)
+DATA 0xFFD01498 0x00000000	#  DDR ODT Control (High)
+# bit1-0:  00, ODT0 controlled by ODT Control (low) register above
+# bit3-2:  01, ODT1 active NEVER!
+# bit31-4: zero, required
+
+DATA 0xFFD0149C 0x0000E803	# CPU ODT Control
+DATA 0xFFD01480 0x00000001	# DDR Initialization Control
+#bit0=1, enable DDR init upon this register write
+
+# End of Header extension
+DATA 0x0 0x0
diff --git a/board/promwad/wtplug_tc/wtplug_tc.c b/board/promwad/wtplug_tc/wtplug_tc.c
new file mode 100644
index 00000000000..4cf1f160646
--- /dev/null
+++ b/board/promwad/wtplug_tc/wtplug_tc.c
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * (C) Copyright 2011
+ * Promwad Innovation Company <www.promwad.com>
+ * Written-by: Viktar Palstsiuk <viktar.palstsiuk@promwad.com>
+ */
+
+#include <dm.h>
+#include <env.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <iomux.h>
+#include <miiphy.h>
+#include <stdio.h>
+#include <video.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/mach-types.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/soc.h>
+#include <asm/arch/mpp.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/mii.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define GREEN_LED		BIT(7)
+#define RED_LED			BIT(17)
+#define GPU_RESET		BIT(38 - 32)
+#define USB_HS_IND		BIT(46 - 32)
+#define RST_GE			BIT(47 - 32)
+#define RST_USB			BIT(48 - 32)
+
+#define WTPLUG_TC_OE_LOW	(~(GREEN_LED | RED_LED))
+#define WTPLUG_TC_OE_HIGH	(~(GPU_RESET | RST_GE | RST_USB))
+#define WTPLUG_TC_OE_VAL_LOW	GREEN_LED
+#define WTPLUG_TC_OE_VAL_HIGH	RST_GE
+
+#define MV88E1121_PAGE		22
+#define MV88E1121_MAC_CTRL2	21
+#define MV88E1121_RGMII_DELAYS	(BIT(5) | BIT(4))
+
+int board_early_init_f(void)
+{
+	static const u32 kwmpp_config[] = {
+		MPP0_NF_IO2,
+		MPP1_NF_IO3,
+		MPP2_NF_IO4,
+		MPP3_NF_IO5,
+		MPP4_NF_IO6,
+		MPP5_NF_IO7,
+		MPP6_SYSRST_OUTn,
+		MPP7_GPO,		/* green LED */
+		MPP8_TW_SDA,
+		MPP9_TW_SCK,
+		MPP10_UART0_TXD,
+		MPP11_UART0_RXD,
+		MPP12_GPO,
+		MPP13_GPIO,		/* PEX0_RST */
+		MPP14_GPIO,		/* WLAN_DIS */
+		MPP15_GPIO,
+		MPP16_GPIO,
+		MPP17_GPIO,		/* red LED */
+		MPP18_NF_IO0,
+		MPP19_NF_IO1,
+		MPP20_GE1_0,
+		MPP21_GE1_1,
+		MPP22_GE1_2,
+		MPP23_GE1_3,
+		MPP24_GE1_4,
+		MPP25_GE1_5,
+		MPP26_GE1_6,
+		MPP27_GE1_7,
+		MPP28_GPIO,		/* power button */
+		MPP29_GPIO,		/* WLAN LED */
+		MPP30_GE1_10,
+		MPP31_GE1_11,
+		MPP32_GE1_12,
+		MPP33_GE1_13,
+		MPP34_GPIO,
+		MPP35_GPIO,		/* PEX0_CLKREQ */
+		MPP36_TW1_SDA,
+		MPP37_TW1_SCK,
+		MPP38_GPIO,		/* GPU_RESET */
+		MPP39_AUDIO_I2SBCLK,
+		MPP40_AUDIO_I2SDO,
+		MPP41_AUDIO_I2SLRC,
+		MPP42_AUDIO_I2SMCLK,
+		MPP43_AUDIO_I2SDI,
+		MPP44_GPIO,		/* WAKE_WIFI */
+		MPP45_GPIO,		/* USB_IND */
+		MPP46_GPIO,		/* USB2517 HS_IND/CFG_SEL1 strap */
+		MPP47_GPIO,		/* RST_GE */
+		MPP48_GPIO,		/* RST_USB */
+		MPP49_GPIO,
+		0
+	};
+
+	mvebu_config_gpio(WTPLUG_TC_OE_VAL_LOW, WTPLUG_TC_OE_VAL_HIGH,
+			  WTPLUG_TC_OE_LOW, WTPLUG_TC_OE_HIGH);
+	kirkwood_mpp_conf(kwmpp_config, NULL);
+
+	return 0;
+}
+
+int board_init(void)
+{
+	struct kwgpio_registers *gpio1 =
+		(struct kwgpio_registers *)MVEBU_GPIO1_BASE;
+
+	gd->bd->bi_arch_number = MACH_TYPE_WTPLUG;
+	gd->bd->bi_boot_params = mvebu_sdram_bar(0) + 0x100;
+
+	/* Stock keeps GPU in reset 200 ms before PCIe init */
+	mdelay(200);
+	setbits_le32(&gpio1->dout, GPU_RESET);
+
+	return 0;
+}
+
+/* Stock U-Boot enables RGMII delays in both ports of the 88E1121R */
+static void wtplug_tc_phy_init(void)
+{
+	struct udevice *eth;
+	struct mii_dev *bus;
+	int addr, reg;
+
+	if (uclass_first_device_err(UCLASS_ETH, &eth))
+		return;
+
+	bus = miiphy_get_dev_by_name(eth->name);
+	if (!bus)
+		return;
+
+	for (addr = 0; addr < 2; addr++) {
+		bus->write(bus, addr, MDIO_DEVAD_NONE, MV88E1121_PAGE, 2);
+		reg = bus->read(bus, addr, MDIO_DEVAD_NONE, MV88E1121_MAC_CTRL2);
+		bus->write(bus, addr, MDIO_DEVAD_NONE, MV88E1121_MAC_CTRL2,
+			   reg | MV88E1121_RGMII_DELAYS);
+		bus->write(bus, addr, MDIO_DEVAD_NONE, MV88E1121_PAGE, 0);
+		reg = bus->read(bus, addr, MDIO_DEVAD_NONE, MII_BMCR);
+		bus->write(bus, addr, MDIO_DEVAD_NONE, MII_BMCR,
+			   reg | BMCR_RESET);
+	}
+}
+
+/*
+ * USB2517 latches CFG_SEL1 from its HS_IND pin at reset release. Board
+ * pull there is wrong, so drive the level that selects SMBus configuration
+ * while driver resets the hub, then hand the pin back to it.
+ */
+static void wtplug_tc_usb_hub_init(void)
+{
+	struct kwgpio_registers *gpio1 =
+		(struct kwgpio_registers *)MVEBU_GPIO1_BASE;
+	struct udevice *hub;
+	int ret;
+
+	clrbits_le32(&gpio1->dout, USB_HS_IND);
+	clrbits_le32(&gpio1->oe, USB_HS_IND);
+
+	ret = uclass_get_device_by_name(UCLASS_MISC, "usb-hub@2c", &hub);
+
+	setbits_le32(&gpio1->oe, USB_HS_IND);
+
+	if (ret)
+		printf("USB hub: configuration failed (%d)\n", ret);
+}
+
+static void wtplug_tc_attach_console(const int file, const char *name)
+{
+	const char *devs = env_get(name);
+
+	if (devs)
+		iomux_doenv(file, devs);
+}
+
+static void wtplug_tc_video_init(void)
+{
+	struct video_priv *priv;
+	struct udevice *video;
+	int ret;
+
+	ret = uclass_first_device_err(UCLASS_VIDEO, &video);
+	if (ret) {
+		printf("Video: init failed (%d)\n", ret);
+		return;
+	}
+
+	/* The PCI video console appears only now, after console_init_r() */
+	if (IS_ENABLED(CONFIG_CONSOLE_MUX)) {
+		wtplug_tc_attach_console(stdout, "stdout");
+		wtplug_tc_attach_console(stderr, "stderr");
+	}
+
+	priv = dev_get_uclass_priv(video);
+	printf("Video: %dx%dx%d\n", priv->xsize, priv->ysize,
+	       VNBITS(priv->bpix));
+}
+
+int board_late_init(void)
+{
+	wtplug_tc_phy_init();
+	wtplug_tc_usb_hub_init();
+
+	/* PCI needs the MBus windows and DRAM info set up by arch_misc_init() */
+	pci_init();
+	wtplug_tc_video_init();
+
+	return 0;
+}
+
+/*
+ * Give the kernel the board DTS without kirkwood-wtplug-tc-u-boot.dtsi:
+ * PERST would lose the GPU mode set up for xgi-fb, and Linux maps MBus
+ * windows for both PCIe ports itself.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int node;
+
+	node = fdt_path_offset(blob, "/mbus@f1000000/pcie@82000000/pcie@1,0");
+	if (node >= 0)
+		fdt_delprop(blob, node, "reset-gpios");
+
+	node = fdt_path_offset(blob, "/mbus@f1000000/pcie@82000000/pcie@2,0");
+	if (node < 0)
+		return 0;
+
+	return fdt_setprop_string(blob, node, "status", "okay");
+}
